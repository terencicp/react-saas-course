---
// Small uppercase line rendered above the H1 on every lesson page.
// Wired in via the PageTitle override (src/components/overrides/PageTitle.astro),
// which reads chapter-id and sidebar.order from frontmatter and passes them in
// as props. Authors never instantiate this in MDX directly.
interface Props {
    /** Padded chapter id from frontmatter, e.g. "091". */
    chapterId?: string;
    /** Lesson order within the chapter (sidebar.order). */
    lessonNumber?: number;
}

const { chapterId, lessonNumber } = Astro.props;

const displayChapterId = chapterId?.replace(/^0+/, "") || chapterId;
const hasAny = Boolean(chapterId) || lessonNumber != null;
---

{
    hasAny && (
        <div class="lesson-eyebrow not-content">
            {chapterId && <span>Chapter {displayChapterId}</span>}
            {lessonNumber != null && (
                <>
                    {chapterId && (
                        <span class="sep" aria-hidden="true">
                            ·
                        </span>
                    )}
                    <span>Lesson {lessonNumber}</span>
                </>
            )}
        </div>
    )
}

<style>
    .lesson-eyebrow {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0;
        /* Pull the eyebrow up so its text baseline lines up with the sidebar's
       first unit divider ("JavaScript and TypeScript"). Both panes meet the
       same header hairline, but the content panel adds 24px padding-top above
       this block while the sidebar unit sits only 20px below the hairline —
       a -4px top margin closes that 4px gap. The 0.375rem bottom margin keeps
       the eyebrow sitting flush against the H1 below it. */
        margin: -0.3rem 0 0.375rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--sl-color-accent);
        line-height: 1.4;
    }
    .lesson-eyebrow .sep {
        margin: 0 0.5em;
        color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    }
</style>
